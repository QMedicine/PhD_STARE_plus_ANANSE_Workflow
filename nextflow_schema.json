{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QMedicine/PhD_STARE_plus_ANANSE_Workflow/nextflow_schema.json",
  "title": "phd_stare_plus_ananse_workflow parameters",
  "type": "object",
  "required": [
    "samplesheet",
    "source2target"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "enum": [
        "preflight",
        "rna_recount",
        "historical_replay",
        "bam_historical_hic_checkpoint",
        "atac_historical_hic_checkpoint",
        "network_replay",
        "raw_prepare",
        "cooler_estimated_ice",
        "hic_diffhic_counts"
      ],
      "default": "preflight"
    },
    "reverse_contrast": {
      "type": "boolean",
      "default": true
    },
    "make_reports": {
      "type": "boolean",
      "default": true
    },
    "process_fastq": {
      "type": "boolean",
      "default": false,
      "description": "Process all RNA/ATAC FASTQ entries before the selected downstream stage"
    },
    "atac_modes": {
      "type": "array",
      "items": {
        "enum": [
          "corrected_column_order",
          "historical_column_order"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": [
        "corrected_column_order"
      ]
    },
    "historical_header_samples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "historical_data_samples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "deseq_state_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "container_binds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "chosen_res": {
      "type": "integer",
      "minimum": 1,
      "default": 100000
    },
    "resolutions": {
      "type": "string",
      "pattern": "^[0-9]+(,[0-9]+)*$",
      "default": "30000,50000,100000"
    },
    "hicexp_norm": {
      "type": "string",
      "enum": [
        "ICE"
      ],
      "default": "ICE"
    },
    "hicexp_depth_norm": {
      "type": "string",
      "enum": [
        "smallest"
      ],
      "default": "smallest"
    },
    "atac_norm": {
      "type": "string",
      "enum": [
        "loess_offsets"
      ],
      "default": "loess_offsets"
    },
    "diffhic_norm": {
      "type": "string",
      "enum": [
        "loess_offsets"
      ],
      "default": "loess_offsets"
    },
    "empty_plot_policy": {
      "enum": [
        "fail"
      ],
      "default": "fail"
    },
    "plot_settings": {
      "type": "object"
    },
    "plot_fc_limits": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "plot_fc_breaks": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "min_count": {
      "type": "integer",
      "minimum": 1
    },
    "min_count_tf": {
      "type": "integer",
      "minimum": 1
    },
    "summit_flank": {
      "type": "integer",
      "minimum": 0
    },
    "stare_window": {
      "type": "integer",
      "minimum": 1
    },
    "enhancer_window": {
      "type": "integer",
      "minimum": 1
    },
    "influence_edges": {
      "type": "integer",
      "minimum": 1
    },
    "min_tpm": {
      "type": "number",
      "minimum": 0
    },
    "min_tpm_tf": {
      "type": "number",
      "minimum": 0
    },
    "gabc_threshold": {
      "type": "number",
      "minimum": 0
    },
    "min_binding": {
      "type": "number",
      "minimum": 0
    },
    "samplesheet": {
      "type": [
        "string",
        "null"
      ]
    },
    "source2target": {
      "type": [
        "string",
        "null"
      ]
    },
    "affinities": {
      "type": [
        "string",
        "null"
      ]
    },
    "de_manifest": {
      "type": [
        "string",
        "null"
      ]
    },
    "hic_checkpoints": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_counts": {
      "type": [
        "string",
        "null"
      ]
    },
    "tpm": {
      "type": [
        "string",
        "null"
      ]
    },
    "idmap": {
      "type": [
        "string",
        "null"
      ]
    },
    "gene_lengths": {
      "type": [
        "string",
        "null"
      ]
    },
    "fasta": {
      "type": [
        "string",
        "null"
      ]
    },
    "gtf": {
      "type": [
        "string",
        "null"
      ]
    },
    "psem": {
      "type": [
        "string",
        "null"
      ]
    },
    "chrom_sizes": {
      "type": [
        "string",
        "null"
      ]
    },
    "atac_blacklist": {
      "type": [
        "string",
        "null"
      ]
    },
    "summit_blacklist": {
      "type": [
        "string",
        "null"
      ]
    },
    "plot_template": {
      "type": [
        "string",
        "null"
      ]
    },
    "ananse_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "r_plot_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "tpm_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "featurecounts_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "hicexplorer_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "atac_tools_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "bedtools_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "stare_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "deseq2_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "network_manifest": {
      "type": [
        "string",
        "null"
      ]
    },
    "union_windows": {
      "type": [
        "string",
        "null"
      ],
      "description": "Explicit authentic named summit-window BED checkpoint, preserving original peak universe"
    },
    "raw_tools_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "rna_adapters": {
      "type": [
        "string",
        "null"
      ]
    },
    "star_index": {
      "type": [
        "string",
        "null"
      ]
    },
    "bowtie_index": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_sample_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "chromosomes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "atac_excluded_contigs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "atac_contig_filter_mode": {
      "enum": [
        "legacy_line_substring",
        "rname"
      ],
      "default": "legacy_line_substring"
    },
    "rna_trim_quality": {
      "type": "integer",
      "minimum": 0
    },
    "rna_min_read_length": {
      "type": "integer",
      "minimum": 0
    },
    "star_sort_ram": {
      "type": "integer",
      "minimum": 0
    },
    "atac_mapq": {
      "type": "integer",
      "minimum": 0
    },
    "atac_genome_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "atac_peak_qvalue": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.05
    },
    "hic_coolers": {
      "type": [
        "string",
        "null"
      ]
    },
    "ice_thresholds": {
      "type": [
        "string",
        "null"
      ]
    },
    "rna_counts_mode": {
      "type": "string",
      "enum": [
        "historical_selection",
        "annotation_symbol_sum"
      ],
      "default": "historical_selection"
    },
    "atac_samtools": {
      "type": "string",
      "enum": [
        "samtools120",
        "samtools"
      ],
      "default": "samtools120"
    },
    "atac_sort_threads": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "hic_raw_container": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pinned standard mapper candidate image"
    },
    "hic_alignment_mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "diffhic_presplit_standard_compat",
        null
      ],
      "default": null
    },
    "hic_ligation_signature": {
      "type": "string",
      "pattern": "^(?:[ACGT]{2})+$",
      "default": "GATCGATC"
    },
    "hic_restriction_sites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[ACGT]+$"
      },
      "default": [
        "GATC"
      ]
    },
    "diffhic_container": {
      "type": [
        "string",
        "null"
      ]
    },
    "hic_overhang": {
      "type": "integer",
      "minimum": 0,
      "default": 4
    },
    "hic_mapq": {
      "type": "integer",
      "minimum": 0,
      "default": 10
    },
    "hic_chim_dist": {
      "type": "integer",
      "minimum": 0,
      "default": 1000
    },
    "hic_max_frag": {
      "type": "integer",
      "minimum": 1,
      "default": 800
    },
    "hic_min_inward": {
      "type": "integer",
      "minimum": 0,
      "default": 1000
    },
    "hic_min_outward": {
      "type": "integer",
      "minimum": 0,
      "default": 1000
    },
    "hic_count_filter": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "atac_fastq_header_mode": {
      "type": "string",
      "enum": [
        "preserve",
        "sra_spot_length"
      ],
      "default": "preserve"
    }
  },
  "additionalProperties": true
}
