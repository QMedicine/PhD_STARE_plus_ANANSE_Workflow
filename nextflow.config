manifest {
    name = 'phd_stare_plus_ananse_workflow'
    description = 'Evidence-led reconstruction of the PhD STARE gABC / ANANSE hybrid'
    version = '0.1.0-dev'
    nextflowVersion = '>=26.04.3'
}
params {
    stage = 'preflight'
    make_reports = true
    trace_suffix = 'local'
    atac_modes = ['corrected_column_order']
    historical_header_samples = []
    historical_data_samples = []
    deseq_state_order = []
    report_manifest = null
    plot_template = null
    plot_fc_limits = [-2,2]
    plot_fc_breaks = [-2,-1,0,1,2]
    plot_settings = [:]
    empty_plot_policy = 'center_warning'
    plot_min_edge_weight = 0.01
    plot_padj_cutoff = 0.05
    plot_abs_lfc_cutoff = 0.25
    make_relaxed_reports = true
    relaxed_plot_edge_factor = 0.1
    relaxed_plot_abs_lfc_cutoff = 0.1
    container_binds = []
    samplesheet = null
    source2target = null
    outdir = 'results'
    reverse_contrast = true
    resolutions = '30000,50000,100000'
    chosen_res = 100000
    chromosomes = []
    hicexp_norm = 'ICE'
    hicexp_depth_norm = 'smallest'
    diffhic_norm = 'loess_offsets'
    atac_norm = 'loess_offsets'
    min_count = 50
    min_count_tf = 50
    min_tpm = 0.1
    min_tpm_tf = 0.1
    summit_flank = 250
    stare_window = 5000000
    enhancer_window = 5000000
    gabc_threshold = 0.02
    min_binding = 0.0
    influence_edges = 100000
    affinities = null
    network_manifest = null
    de_manifest = null
    hic_checkpoints = null
    hic_coolers = null
    ice_thresholds = null
    selected_counts = null
    tpm = null
    idmap = null
    gene_lengths = null
    fasta = null
    gtf = null
    psem = null
    chrom_sizes = null
    atac_blacklist = null
    summit_blacklist = null
    union_windows = null
    raw_tools_container = null
    hic_raw_container = null
    hic_alignment_mode = null
    hic_ligation_signature = 'GATCGATC'
    hic_restriction_sites = ['GATC']
    diffhic_container = null
    hic_contacts_from_diffhic = false
    hic_overhang = 4
    hic_mapq = 10
    hic_chim_dist = 1000
    hic_max_frag = 800
    hic_min_inward = 1000
    hic_min_outward = 1000
    hic_count_filter = 1
    raw_sample_names = []
    process_fastq = false
    rna_counts_mode = 'historical_selection'
    rna_adapters = null
    star_index = null
    bowtie_index = null
    bowtie_index_name = 'genome'
    rna_trim_quality = 20
    rna_min_read_length = 20
    star_sort_ram = 20000000000
    atac_mapq = 10
    atac_fastq_header_mode = 'preserve'
    atac_samtools = 'samtools120'
    atac_sort_threads = 1
    atac_excluded_contigs = []
    atac_contig_filter_mode = 'legacy_line_substring'
    atac_genome_size = null
    atac_peak_qvalue = 0.05
    ananse_container = null
    r_plot_container = null
    tpm_container = null
    featurecounts_container = null
    hicexplorer_container = null
    atac_tools_container = null
    bedtools_container = null
    stare_container = null
    deseq2_container = null
    slurm_account = 'wehi'
    slurm_partition = 'regular'
    mail_user = 'stacpoole.q@wehi.edu.au'
}
process {
    errorStrategy = 'terminate'
    maxRetries = 0
    cpus = 2
    memory = '8 GB'
    time = '1h'
    withLabel: raw_tools { container = params.raw_tools_container; containerOptions = '--no-home' }
    withLabel: hic_raw { container = params.hic_raw_container; containerOptions = '--no-home' }
    withLabel: diffhic { container = params.diffhic_container; containerOptions = '--no-home' }
    withLabel: ananse { container = params.ananse_container; containerOptions = '--no-home' }
    withLabel: r_plot { container = params.r_plot_container; containerOptions = '--no-home' }
    withLabel: tpm { container = params.tpm_container; containerOptions = '--no-home' }
    withLabel: featurecounts { container = params.featurecounts_container }
    withLabel: hicexplorer { container = params.hicexplorer_container; containerOptions = '--no-home' }
    withLabel: atac_tools { container = params.atac_tools_container }
    withLabel: bedtools { container = params.bedtools_container }
    withLabel: stare { container = params.stare_container }
    withLabel: deseq2 { container = params.deseq2_container }
}
profiles {
    local { process.executor = 'local' }
    wehi {
        process.executor = 'slurm'
        process.queue = params.slurm_partition
        process.clusterOptions = { "--account=${params.slurm_account}" }
        executor.queueSize = 4
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.runOptions = '--cleanenv' + (params.container_binds ? ' --bind ' + params.container_binds.join(',') : '')
    }
}
trace { enabled = true; file = "${params.outdir}/provenance/trace_${params.trace_suffix}.tsv" }
report { enabled = true; file = "${params.outdir}/provenance/nextflow_report_${params.trace_suffix}.html" }
timeline { enabled = true; file = "${params.outdir}/provenance/timeline_${params.trace_suffix}.html" }
dag { enabled = true; file = "${params.outdir}/provenance/dag_${params.trace_suffix}.html" }
