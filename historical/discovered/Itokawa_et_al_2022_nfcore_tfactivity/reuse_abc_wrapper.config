// reuse_abc_wrapper.config
// Map CSV format: sample,abc   (sample must match meta.id, e.g. Old_HSC_B1_Rep1)
// Example row: Old_HSC_B1_Rep1,/.../Old_HSC_ABCpp_scoredInteractions_Old_HSC.txt.gz

process {
  withName: ".*:PEAKS:STARE" {
    beforeScript = '''
set -euo pipefail

# Host paths (adjust if different on your system)
SHIM_SRC="/vast/projects/Immune_Aging/Itokawa_et_al_2022_nfcore_tfactivity/tools/stare_shim.sh"
MAP_SRC="/vast/projects/Immune_Aging/Itokawa_et_al_2022_nfcore_tfactivity/abc_by_sample.csv"

mkdir -p .shim
cp "$SHIM_SRC" .shim/STARE.sh
cp "$MAP_SRC"  .shim/abc_map.csv
chmod +x .shim/STARE.sh

# Capture the real STARE.sh path (before we override it) for the shim to call
REAL=$(command -v STARE.sh || true)
printf "%s\n" "${REAL:-/bin/false}" > .shim/.real_path

# Define a shell function that overrides STARE.sh inside the container
printf 'STARE.sh() { "$PWD/.shim/STARE.sh" "$@"; }\n' > .shim/bashenv

# Make the function/shim visible inside the container
export SINGULARITYENV_BASH_ENV="$PWD/.shim/bashenv"
export SINGULARITYENV_PATH="$PWD/.shim:$PATH"

# Breadcrumbs
echo "[shim-setup] Staged shim to $PWD/.shim/STARE.sh" >&2
echo "[shim-setup] Copied map to  $PWD/.shim/abc_map.csv" >&2
echo "[shim-setup] Real STARE at  $(cat .shim/.real_path)" >&2
echo "[shim-setup] Installed BASH_ENV at $PWD/.shim/bashenv" >&2
'''
  }
}
