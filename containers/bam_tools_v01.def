Bootstrap: localimage
From: /vast/projects/Immune_Aging/apptainer_singularity_cache/stare-abc_1.0.5.sif

%files
    /vast/scratch/users/stacpoole.q/PhD_STARE_plus_ANANSE_Workflow/containers/bam_tools_v01.tar /opt/bam_tools_v01.tar

%post
    busybox tar -xf /opt/bam_tools_v01.tar -C /opt
    rm /opt/bam_tools_v01.tar

%environment
    export PATH=/opt/tools:$PATH
    export LD_LIBRARY_PATH=/opt/tool-libs:${LD_LIBRARY_PATH:-}

%test
    LD_LIBRARY_PATH=/opt/tool-libs:${LD_LIBRARY_PATH:-} /opt/tools/samtools --version
    LD_LIBRARY_PATH=/opt/tool-libs:${LD_LIBRARY_PATH:-} /opt/tools/bedtools --version
    LD_LIBRARY_PATH=/opt/tool-libs:${LD_LIBRARY_PATH:-} /opt/tools/featureCounts -v

%labels
    workflow phd_stare_plus_ananse_workflow
    versions samtools_1.22.1_bedtools_2.31.1_subread_2.0.6
